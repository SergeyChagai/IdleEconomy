#
# https://github.com/luau-lang/luau
# https://luau.org/

# Code coverage
coverage.out

# Profiling
profile.out
profile.svg

# Time trace
trace.json

# Built place -- an artifact of `rojo build`, rebuilt from source.
# The .lock files are created by Studio while a place is open.
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Project map for luau-lsp -- generated by `rojo sourcemap`
sourcemap.json

# Wally-managed dependencies -- restored by `wally install`.
# wally.toml and wally.lock are committed, the packages themselves are not.
/Packages/
/ServerPackages/
/DevPackages/

# Meronq local state: memory database and snapshots, machine-specific
.meronq/local/*
!.meronq/local/.gitkeep
